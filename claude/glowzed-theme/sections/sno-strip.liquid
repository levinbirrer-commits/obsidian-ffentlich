<section class="strip" aria-label="{{ 'sno.our_promise' | t }}">
  <div class="wrap strip__grid">
    {%- for block in section.blocks -%}
      <div class="strip__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>
          {%- when 'trend' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 16l5-5 4 4 7-7"/><path d="M15 8h5v5"/></svg>
          {%- when 'lock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
          {%- when 'return' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 12a8 8 0 1 0 3-6.2"/><path d="M4 4v4h4"/></svg>
          {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="m12 4 2.4 5 5.6.8-4 3.9.9 5.5L12 16.6 7.1 19.2l.9-5.5-4-3.9 5.6-.8Z"/></svg>
          {%- when 'chat' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 5h16v11H9l-5 4Z"/></svg>
        {%- endcase -%}
        {{ block.settings.text }}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Promise strip",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "trend", "label": "Trend arrow" }, { "value": "lock", "label": "Lock" },
          { "value": "return", "label": "Return" }, { "value": "star", "label": "Star" }, { "value": "chat", "label": "Chat" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over CHF 35" }
      ]
    }
  ],
  "presets": [{ "name": "Promise strip", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
