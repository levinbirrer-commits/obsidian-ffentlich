<section class="hero password-page">
  <div class="wrap hero__inner">
    <div>
      <span class="eyebrow">{{ 'sno.password.title' | t }}</span>
      <h1>{{ settings.logo_text | default: settings.brand }}<br>{{ 'sno.password.soon_html' | t }}</h1>
      {%- if shop.password_message != blank -%}<p class="hero__lead">{{ shop.password_message }}</p>{%- endif -%}
      {%- form 'customer', class: 'nl-form' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        <input type="email" name="contact[email]" placeholder="{{ 'sno.email_placeholder' | t }}" aria-label="{{ 'sno.email' | t }}" required>
        <button class="btn btn--solid" type="submit">{{ 'sno.password.notify' | t }}</button>
      {%- endform -%}
      <details class="pw-login">
        <summary>{{ 'sno.password.enter_with_password' | t }}</summary>
        {%- form 'storefront_password', class: 'nl-form' -%}
          {%- if form.errors %}<p class="form-err">{{ form.errors | default_errors }}</p>{% endif -%}
          <input type="password" name="password" placeholder="{{ 'sno.password.password' | t }}" aria-label="{{ 'sno.password.password' | t }}">
          <button class="btn btn--ghost" type="submit">{{ 'sno.password.enter' | t }}</button>
        {%- endform -%}
      </details>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Glowzed Password", "settings": [] }
{% endschema %}
