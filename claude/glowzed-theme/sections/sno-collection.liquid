{%- liquid
  assign eyebrow = collection.metafields.custom.eyebrow.value | default: section.settings.eyebrow
  assign min_price = 0
  for p in collection.products
    if min_price == 0 or p.price < min_price
      assign min_price = p.price
    endif
  endfor
-%}
<section class="page-hero">
  <div class="wrap page-hero__inner">
    <div>
      <nav class="crumbs"><a href="{{ routes.root_url }}">{{ 'sno.home' | t }}</a> / {{ collection.title }}</nav>
      {%- if eyebrow != blank -%}<span class="eyebrow">{{ eyebrow }}</span>{%- endif -%}
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="page-hero__text">{{ collection.description | strip_html }}</p>
      {%- endif -%}
      <p class="page-hero__count">{{ 'sno.products_count' | t | replace: '[n]', collection.products_count }}{% if min_price > 0 %}{%- assign mp = min_price | money %} · {{ 'sno.from_price' | t | replace: '[price]', mp }}{% endif %}</p>
    </div>
    {%- if section.settings.show_lineup -%}
      <div class="page-hero__art">
        {%- render 'sno-lineup', products: collection.products, max: section.settings.lineup_count, tag: 'a' -%}
      </div>
    {%- endif -%}
  </div>
</section>

<section class="section cat">
  <div class="wrap">
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="grid">
        {%- for p in collection.products -%}
          {%- render 'sno-card', product: p -%}
        {%- else -%}
          <p class="muted-note">{{ 'sno.collection.soon' | t }}</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pager">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{%- if section.settings.more_menu != blank -%}
  <section class="more">
    <div class="wrap more__inner">
      <span class="eyebrow">{{ section.settings.more_label }}</span>
      <div class="more__links">
        {%- for link in section.settings.more_menu.links -%}
          {%- unless link.active -%}
            <a class="more-cat" href="{{ link.url }}"><span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{{ link.title }} →</a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading (fallback)", "info": "Per collection you can set it in the collection metafield “Kleine Überschrift”", "default": "Shop" },
    { "type": "checkbox", "id": "show_lineup", "label": "Show products on the mirror floor", "default": true },
    { "type": "range", "id": "lineup_count", "label": "Products on the mirror floor", "min": 1, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 48, "step": 3, "default": 48 },
    { "type": "link_list", "id": "more_menu", "label": "“Keep browsing” menu", "info": "e.g. your category menu" },
    { "type": "text", "id": "more_label", "label": "“Keep browsing” label", "default": "Keep browsing" }
  ]
}
{% endschema %}
