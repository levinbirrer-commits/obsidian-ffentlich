{%- liquid
  assign crumb = page.title | default: section.settings.heading | strip_html
  assign heading = section.settings.heading | default: page.title
-%}
<section class="page-hero">
  <div class="wrap page-hero__inner page-hero__inner--text">
    <div>
      <nav class="crumbs"><a href="{{ routes.root_url }}">{{ 'sno.home' | t }}</a> / {{ crumb }}</nav>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="page-hero__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page heading",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "HTML allowed, e.g. Five <em>minutes.</em> Empty = page title" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Page heading" }]
}
{% endschema %}
