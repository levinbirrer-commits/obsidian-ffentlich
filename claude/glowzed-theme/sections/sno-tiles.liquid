<section class="section" id="shop">
  <div class="wrap">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.note != blank -%}<p class="section__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
    <div class="tiles tiles--4">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign picks = block.settings.products
          if picks == blank
            assign picks = c.products
          endif
          assign number = block.settings.number | default: forloop.index | prepend: '0' | slice: -2, 2
        -%}
        <a class="tile" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="tile__art tile__art--photo">
            {%- render 'sno-lineup', products: picks, max: 3, tag: 'span' -%}
          </div>
          <div class="tile__body">
            <span class="tile__n">{{ number }}</span>
            <h3>{{ block.settings.title | default: c.title }}</h3>
            {%- if c != blank -%}<span class="tile__count">{{ 'sno.products_count' | t | replace: '[n]', c.products_count }} →</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "HTML allowed, e.g. <em>One</em>", "default": "Four categories. <em>One</em> goal." },
    { "type": "text", "id": "note", "label": "Text", "default": "Everything that belongs in a routine you will actually stick to." }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title (optional)", "info": "Empty = collection title" },
        { "type": "text", "id": "number", "label": "Number (optional)", "info": "Empty = 01, 02, …" },
        { "type": "product_list", "id": "products", "label": "Products on the mirror floor (optional)", "info": "Up to 3. Empty = first products of the collection with a cut-out image", "limit": 3 }
      ]
    }
  ],
  "presets": [{ "name": "Category tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
