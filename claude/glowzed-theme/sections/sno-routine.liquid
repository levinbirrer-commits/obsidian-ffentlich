<section class="section ritual">
  <div class="wrap">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.note != blank -%}<p class="section__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <div class="step" {{ block.shopify_attributes }}>
          <div class="step__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          <h3 class="step__title">{{ block.settings.title }} {% if block.settings.time != blank %}<span class="step__time">{{ block.settings.time }}</span>{% endif %}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          {%- if p != blank -%}
            <a class="step__photo stage" href="{{ p.url }}" aria-label="{{ p.title | escape }}">{%- render 'sno-img', product: p -%}</a>
            <a class="step__link" href="{{ p.url }}">{{ p.title }} →</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Routine steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Morning" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "HTML allowed, e.g. <em>awake.</em>", "default": "Look <em>awake.</em>" },
    { "type": "text", "id": "note", "label": "Text (optional)" }
  ],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cleanse" },
        { "type": "text", "id": "time", "label": "Time", "default": "30 sec" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Wash off the oil and dirt from the night. Lukewarm, not hot." }
      ]
    }
  ],
  "presets": [{ "name": "Routine steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
