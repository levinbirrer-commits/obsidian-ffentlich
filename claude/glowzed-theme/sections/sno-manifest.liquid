<section class="section manifest">
  <div class="wrap manifest__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text_1 != blank -%}<p class="lead">{{ section.settings.text_1 }}</p>{%- endif -%}
      {%- if section.settings.text_2 != blank -%}<p class="lead">{{ section.settings.text_2 }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <table class="compare">
        <thead><tr><th>{{ section.settings.col_left }}</th><th>{{ section.settings.col_right | default: settings.brand }}</th></tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}><td>{{ block.settings.left }}</td><td>{{ block.settings.right }}</td></tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Statement with comparison",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our stance" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "HTML allowed", "default": "No bone smashing. <em>Ever.</em>" },
    { "type": "textarea", "id": "text_1", "label": "Text 1", "default": "Looksmaxxing has turned into a race for the riskiest method. We are not part of it." },
    { "type": "textarea", "id": "text_2", "label": "Text 2" },
    { "type": "text", "id": "col_left", "label": "Left column title", "default": "Hardmaxxing" },
    { "type": "text", "id": "col_right", "label": "Right column title", "info": "Empty = brand name" }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "left", "label": "Left (✕)", "default": "Hitting your jaw with a hammer" },
        { "type": "text", "id": "right", "label": "Right (✓)", "default": "Facial massage with gua sha" }
      ]
    }
  ],
  "presets": [{ "name": "Statement with comparison", "blocks": [{ "type": "row" }] }]
}
{% endschema %}
