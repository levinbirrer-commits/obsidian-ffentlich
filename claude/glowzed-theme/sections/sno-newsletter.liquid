<section class="section newsletter">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.sub != blank -%}<p class="sub">{{ section.settings.sub }}</p>{%- endif -%}
    {%- form 'customer', class: 'nl-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="nl-email-{{ section.id }}" style="position:absolute;left:-9999px">{{ 'sno.email' | t }}</label>
      <input id="nl-email-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ 'sno.email_placeholder' | t }}" required>
      <button class="btn btn--solid" type="submit">{{ section.settings.button }}</button>
      {%- if form.posted_successfully? -%}
        <p class="nl-note nl-note--ok">{{ section.settings.success }}</p>
      {%- elsif form.errors -%}
        <p class="nl-note">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}
    {%- if section.settings.note != blank -%}<p class="nl-note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Club" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "HTML allowed", "default": "10% off your <em>first</em> order." },
    { "type": "text", "id": "sub", "label": "Text", "default": "New drops, routine guides and zero spam. Unsubscribe anytime." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Sign up" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "You're in. Your code: WELCOME10 (10% off your first order)." },
    { "type": "text", "id": "note", "label": "Small note", "default": "No spam. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
