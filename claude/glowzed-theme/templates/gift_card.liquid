{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ 'sno.gift_card.title' | t }} — {{ shop.name }}</title>
  {{ 'sno.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="wrap notfound">
    <span class="eyebrow">{{ 'sno.gift_card.title' | t }}</span>
    <h1 class="h2">{{ gift_card.initial_value | money }}</h1>
    <p>{{ 'sno.gift_card.code' | t }} <strong>{{ gift_card.code | format_code }}</strong></p>
    <p>{{ 'sno.gift_card.balance' | t }} {{ gift_card.balance | money }}{% if gift_card.expired %} · {{ 'sno.gift_card.expired' | t }}{% endif %}</p>
    <a class="btn btn--solid" href="{{ shop.url }}">{{ 'sno.go_to_shop' | t }}</a>
  </main>
</body>
</html>
