<section class="page-hero">
  <div class="wrap page-hero__inner page-hero__inner--text">
    <div>
      <nav class="crumbs"><a href="{{ routes.root_url }}">{{ 'sno.home' | t }}</a> / {{ crumb }}</nav>
      <span class="eyebrow">{{ eyebrow }}</span>
      <h1>{{ heading }}</h1>
      {%- if text != blank -%}<p class="page-hero__text">{{ text }}</p>{%- endif -%}
    </div>
  </div>
</section>
