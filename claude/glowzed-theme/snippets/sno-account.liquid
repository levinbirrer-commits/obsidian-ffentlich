{%- comment -%}
  Konto-Button im Header mit eigenem Panel (Aufruf: render 'sno-account', s: section.settings).
  Abgemeldet: Tabs „Sign in“ / „Create account“. Beides läuft über Shopifys Anmeldung mit Code per Mail
  (neue Kundenkonten: eine unbekannte E-Mail bekommt automatisch ein Konto). Die Adresse wird vorausgefüllt
  (login_hint), danach geht es zurück auf die aktuelle Seite; nach „Create account“ mit ?welcome=1 für die Begrüßung.
  Angemeldet: Initiale, Begrüßung mit Vorname, Bestellungen, Profil, Abmelden.
  Ohne JavaScript ist der Button ein normaler Link und die Formulare sind GET-Formulare.
{%- endcomment -%}
<style>
.acct { position: relative; }
.acct__avatar {
  width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; flex: none;
  background: var(--chrome); color: var(--ink); font-size: 13px; font-weight: 700; line-height: 1;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, .2), 0 6px 14px -6px rgba(0, 0, 0, .9);
}
.acct__avatar--lg { width: 48px; height: 48px; font-size: 19px; }
.acct.is-open .acct__btn { background: var(--surface-2); }
.acct__panel {
  position: absolute; top: calc(100% + 14px); right: -8px; z-index: 60;
  width: 360px; max-width: calc(100vw - 24px); padding: 22px 24px 22px; text-align: left;
  border-radius: var(--r); border: 1px solid rgba(255, 255, 255, .1);
  background: var(--speckle-soft) 0 0 / 420px 420px, var(--lacquer);
  box-shadow: var(--hi), 0 40px 80px -30px rgba(0, 0, 0, .95);
  animation: acctIn .22s var(--ease);
}
.acct__panel[hidden], .acct [data-acct-view][hidden] { display: none; }
@keyframes acctIn { from { opacity: 0; transform: translateY(-6px); } }
.acct__x { position: absolute; top: 14px; right: 12px; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; color: var(--muted); }
.acct__x:hover { color: var(--text); background: rgba(255, 255, 255, .06); }
.acct__x svg { width: 16px; height: 16px; }
.acct__tabs { display: inline-flex; gap: 4px; padding: 4px; margin-right: 36px; border-radius: 999px; background: rgba(0, 0, 0, .45); border: 1px solid var(--line); }
.acct__tab { height: 32px; padding: 0 15px; border-radius: 999px; font-size: 10.5px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; color: var(--muted); transition: color .2s, background .2s; }
.acct__tab:hover { color: var(--text); }
.acct__tab[aria-selected="true"] { background: linear-gradient(180deg, #ffffff 0%, #eceef1 50%, #d9dce1 100%); color: var(--ink); }
.acct__h { font-size: 27px; line-height: 1.1; font-weight: 500; letter-spacing: -.01em; margin-top: 18px; padding-right: 8px; }
.acct__p { color: var(--muted); font-size: 14px; line-height: 1.5; margin-top: 8px; }
.acct__form { display: grid; gap: 10px; margin-top: 18px; }
.acct__label { font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--dim); }
.acct__form input {
  width: 100%; height: 48px; padding: 0 18px; border-radius: 999px;
  border: 1px solid var(--line-strong); background: rgba(0, 0, 0, .4); color: var(--text); font: inherit; font-size: 16px;
}
.acct__form input::placeholder { color: var(--dim); }
.acct__form input:focus { outline: none; border-color: rgba(255, 255, 255, .55); box-shadow: 0 0 0 3px rgba(255, 255, 255, .08); }
.acct__perks { list-style: none; display: grid; gap: 9px; margin: 20px 0 0; padding: 16px 0 0; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
.acct__perks li { display: flex; gap: 10px; align-items: center; }
.acct__perks svg { width: 14px; height: 14px; flex: none; color: var(--accent); }
.acct__fine { font-size: 12px; color: var(--dim); margin-top: 14px; }
.acct__fine button, .acct__add { color: var(--text); font-size: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255, 255, 255, .35); }
.acct__fine button:hover, .acct__add:hover { text-decoration-color: currentColor; }
.acct__head { display: flex; gap: 14px; align-items: center; padding-right: 24px; }
.acct__who { min-width: 0; }
.acct__head .acct__h { margin-top: 0; font-size: 23px; padding-right: 0; }
.acct__mail { color: var(--dim); font-size: 12px; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.acct__add { display: inline-block; margin-top: 6px; font-size: 12px; }
.acct__stats {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); gap: 1px; margin: 20px 0 14px;
  border-radius: 14px; overflow: hidden; background: var(--line); border: 1px solid var(--line);
}
.acct__stats > * { background: rgba(0, 0, 0, .4); padding: 12px 14px; min-width: 0; }
.acct__stats a:hover { background: rgba(255, 255, 255, .06); }
.acct__stats strong { display: block; font-size: 17px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.acct__stats span { display: block; margin-top: 2px; font-size: 10.5px; color: var(--muted); letter-spacing: .1em; text-transform: uppercase; }
.acct__row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
.acct__row .btn { padding: 0 10px; }
.acct__out { display: inline-block; margin-top: 16px; font-size: 11px; font-weight: 600; color: var(--muted); letter-spacing: .16em; text-transform: uppercase; }
.acct__out:hover { color: var(--text); }
.acct-toast {
  position: fixed; left: 50%; bottom: 24px; z-index: 80; display: flex; align-items: center; gap: 12px;
  width: max-content; max-width: calc(100vw - 32px); padding: 9px 20px 9px 9px; border-radius: 999px; font-size: 14px;
  border: 1px solid rgba(255, 255, 255, .12); background: var(--lacquer); box-shadow: var(--hi), 0 24px 50px -20px rgba(0, 0, 0, .95);
  transform: translate(-50%, 16px); opacity: 0; transition: transform .35s var(--ease), opacity .35s var(--ease);
}
.acct-toast[hidden] { display: none; }
.acct-toast.on { transform: translate(-50%, 0); opacity: 1; }
@media (max-width: 860px) {
  .acct { position: static; }
  .acct__panel { left: 12px; right: 12px; width: auto; max-width: none; top: calc(100% + 8px); }
}
</style>
{%- assign login_url = routes.storefront_login_url | default: routes.account_login_url -%}
{%- assign login_parts = login_url | split: '?' -%}
{%- assign acct_parts = routes.account_url | split: '?' -%}
{%- assign acct_qs = '' -%}
{%- if acct_parts.size > 1 -%}{%- assign acct_qs = '?' | append: acct_parts.last -%}{%- endif -%}
{%- assign profile_url = acct_parts.first | append: '/profile' | append: acct_qs -%}
{%- assign brand_word = settings.logo_text | default: settings.brand | default: shop.name -%}
{%- assign routine_url = pages['your-routine'].url | default: '/pages/your-routine' -%}
{%- if customer -%}
  {%- assign c_first = customer.first_name | strip -%}
  {%- assign c_letter = c_first | default: customer.email | slice: 0 | upcase -%}
{%- else -%}
  {%- comment -%} Versteckte Felder der Anmelde-URL; bei „Create account“ bekommt return_to zusätzlich welcome=1 {%- endcomment -%}
  {%- assign hidden_in = '' -%}
  {%- assign hidden_up = '' -%}
  {%- if login_parts.size > 1 -%}
    {%- assign qs = login_parts.last | split: '&' -%}
    {%- for kv in qs -%}
      {%- assign p = kv | split: '=' -%}
      {%- assign k = p[0] | url_decode -%}
      {%- assign v = p[1] | url_decode -%}
      {%- if k != blank and k != 'login_hint' -%}
        {%- capture inp -%}<input type="hidden" name="{{ k | escape }}" value="{{ v | escape }}">{%- endcapture -%}
        {%- assign hidden_in = hidden_in | append: inp -%}
        {%- if k == 'return_to' -%}
          {%- if v contains '?' -%}{%- assign v = v | append: '&welcome=1' -%}{%- else -%}{%- assign v = v | append: '?welcome=1' -%}{%- endif -%}
          {%- capture inp -%}<input type="hidden" name="return_to" value="{{ v | escape }}">{%- endcapture -%}
        {%- endif -%}
        {%- assign hidden_up = hidden_up | append: inp -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}
<div class="acct" data-acct>
  <a class="icon-btn acct__btn{% if customer %} acct__btn--in{% endif %}" href="{% if customer %}{{ routes.account_url }}{% else %}{{ login_url }}{% endif %}" rel="nofollow" aria-haspopup="dialog" aria-expanded="false" aria-controls="acct-panel" aria-label="{% if customer %}{{ 'sno.account.account' | t }}{% if c_first != blank %}: {{ c_first | escape }}{% endif %}{% else %}{{ 'sno.account.sign_in_or_create' | t }}{% endif %}" data-acct-toggle>
    {%- if customer -%}
      <span class="acct__avatar" aria-hidden="true">{{ c_letter }}</span>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c1.2-3.6 4-5 7-5s5.8 1.4 7 5"/></svg>
    {%- endif -%}
  </a>

  <div class="acct__panel" id="acct-panel" role="dialog" aria-label="{% if customer %}{{ 'sno.account.your_account' | t }}{% else %}{{ 'sno.account.sign_in_or_create' | t }}{% endif %}" hidden>
    <button type="button" class="acct__x" aria-label="{{ 'sno.close' | t }}" data-acct-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    {%- if customer -%}
      <div class="acct__head">
        <span class="acct__avatar acct__avatar--lg" aria-hidden="true">{{ c_letter }}</span>
        <div class="acct__who">
          <p class="acct__h">
            {%- if c_first != blank -%}{{ s.acct_hello }} <em>{{ c_first | escape }}.</em>
            {%- elsif customer.orders_count == 0 -%}{{ 'sno.account.welcome_to' | t }} <em>{{ brand_word }}.</em>
            {%- else -%}{{ 'sno.account.welcome_back_html' | t }}{%- endif -%}
          </p>
          <p class="acct__mail">{{ customer.email }}</p>
          {%- if c_first == blank and s.acct_add_name != blank -%}<a class="acct__add" href="{{ profile_url }}">{{ s.acct_add_name }} →</a>{%- endif -%}
        </div>
      </div>
      <div class="acct__stats">
        <div><strong>{{ customer.orders_count }}</strong><span>{% if customer.orders_count == 1 %}{{ 'sno.account.order' | t }}{% else %}{{ 'sno.account.orders' | t }}{% endif %}</span></div>
        {%- if customer.last_order -%}
          <div><strong>{{ customer.last_order.name }}</strong>{%- liquid
            assign lo_months = 'sno.date.months' | t | split: ','
            assign lo_m = customer.last_order.created_at | date: '%-m' | minus: 1
            assign lo_d = customer.last_order.created_at | date: '%-d'
            assign lo_proc = 'sno.account.processing' | t
          -%}<span>{{ 'sno.date.month_day' | t | replace: '[m]', lo_months[lo_m] | replace: '[d]', lo_d }} · {{ customer.last_order.fulfillment_status_label | default: lo_proc }}</span></div>
        {%- else -%}
          <a href="{{ routine_url }}"><strong>{{ s.acct_first_title }}</strong><span>{{ s.acct_first_text }}</span></a>
        {%- endif -%}
      </div>
      <a class="btn btn--solid btn--block" href="{{ routes.account_url }}">{{ s.acct_orders }}</a>
      <div class="acct__row">
        <a class="btn btn--ghost" href="{{ profile_url }}">{{ 'sno.account.profile' | t }}</a>
        <a class="btn btn--ghost" href="{{ routine_url }}">{{ 'sno.account.routine' | t }}</a>
      </div>
      <a class="acct__out" href="{{ routes.account_logout_url }}">{{ 'sno.account.sign_out' | t }}</a>
    {%- else -%}
      <div class="acct__tabs" role="tablist" aria-label="{{ 'sno.account.account' | t }}">
        <button type="button" role="tab" class="acct__tab" id="acct-tab-in" aria-controls="acct-view-in" aria-selected="true" data-acct-tab="in">{{ s.acct_tab_in }}</button>
        <button type="button" role="tab" class="acct__tab" id="acct-tab-up" aria-controls="acct-view-up" aria-selected="false" data-acct-tab="up">{{ s.acct_tab_up }}</button>
      </div>

      <div id="acct-view-in" role="tabpanel" aria-labelledby="acct-tab-in" data-acct-view="in">
        <p class="acct__h">{{ s.acct_title }} <em>{{ brand_word }}.</em></p>
        {%- if s.acct_text != blank -%}<p class="acct__p">{{ s.acct_text }}</p>{%- endif -%}
        <form class="acct__form" action="{{ login_parts.first }}" method="get">
          {{ hidden_in }}
          <label class="acct__label" for="acct-email-in">{{ 'sno.email' | t }}</label>
          <input id="acct-email-in" type="email" name="login_hint" placeholder="{{ 'sno.account.email_placeholder' | t }}" autocomplete="email" inputmode="email" required>
          <button class="btn btn--solid btn--block" type="submit">{{ s.acct_btn }} →</button>
        </form>
      </div>

      <div id="acct-view-up" role="tabpanel" aria-labelledby="acct-tab-up" data-acct-view="up" hidden>
        <p class="acct__h">{{ s.acct_up_title }} <em>{{ brand_word }}.</em></p>
        {%- if s.acct_up_text != blank -%}<p class="acct__p">{{ s.acct_up_text }}</p>{%- endif -%}
        <form class="acct__form" action="{{ login_parts.first }}" method="get">
          {{ hidden_up }}
          <label class="acct__label" for="acct-email-up">{{ 'sno.email' | t }}</label>
          <input id="acct-email-up" type="email" name="login_hint" placeholder="{{ 'sno.account.email_placeholder' | t }}" autocomplete="email" inputmode="email" required>
          <button class="btn btn--solid btn--block" type="submit">{{ s.acct_up_btn }} →</button>
        </form>
      </div>

      {%- assign perks = s.acct_perks | split: '|' -%}
      {%- if perks.size > 0 -%}
        <ul class="acct__perks">
          {%- for perk in perks -%}
            {%- assign pk = perk | strip -%}
            {%- if pk != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>{{ pk }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <p class="acct__fine" data-acct-view="in">{{ s.acct_fine }} <button type="button" data-acct-tab="up">{{ s.acct_tab_up }}</button></p>
      <p class="acct__fine" data-acct-view="up" hidden>{{ s.acct_fine_up }} <button type="button" data-acct-tab="in">{{ s.acct_tab_in }}</button></p>
    {%- endif -%}
  </div>
</div>
{%- if customer -%}
  {%- assign toast_new = s.acct_toast_new | replace: '[brand]', settings.brand -%}
  <div class="acct-toast" id="acct-toast" data-id="{{ customer.id }}" data-new="{{ toast_new | escape }}" role="status" hidden>
    <span class="acct__avatar" aria-hidden="true">{{ c_letter }}</span>
    <span class="acct-toast__t">{%- if c_first != blank -%}{{ s.acct_toast | replace: '[name]', c_first }}{%- else -%}{{ s.acct_toast | replace: ' [name]', '' | replace: '[name]', '' }}{%- endif -%}</span>
  </div>
{%- endif -%}
<script>
/* Konto-Panel im Header: öffnen/schließen, Tabs Sign in / Create account, Begrüßung nach dem Anmelden */
(function () {
  var wrap = document.querySelector('[data-acct]');
  if (!wrap) return;
  var btn = wrap.querySelector('[data-acct-toggle]');
  var panel = wrap.querySelector('.acct__panel');
  var mode = 'in';
  function focusEmail() {
    var f = panel.querySelector('[data-acct-view="' + mode + '"] input[type=email]');
    if (f && window.matchMedia('(hover: hover)').matches) f.focus();
  }
  function tab(m) {
    var prev = panel.querySelector('[data-acct-view="' + mode + '"] input[type=email]');
    mode = m;
    panel.querySelectorAll('[data-acct-view]').forEach(function (v) { v.hidden = v.getAttribute('data-acct-view') !== m; });
    panel.querySelectorAll('.acct__tab').forEach(function (b) { b.setAttribute('aria-selected', String(b.getAttribute('data-acct-tab') === m)); });
    var next = panel.querySelector('[data-acct-view="' + m + '"] input[type=email]');
    if (prev && next && prev !== next && !next.value) next.value = prev.value;
    focusEmail();
  }
  function set(open, m) {
    panel.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    wrap.classList.toggle('is-open', open);
    if (open) { if (m) tab(m); else focusEmail(); }
  }
  btn.addEventListener('click', function (e) { e.preventDefault(); set(panel.hidden); });
  panel.addEventListener('click', function (e) {
    var tb = e.target.closest('[data-acct-tab]');
    if (tb) tab(tb.getAttribute('data-acct-tab'));
  });
  var x = panel.querySelector('[data-acct-close]');
  if (x) x.addEventListener('click', function () { set(false); btn.focus(); });
  document.addEventListener('click', function (e) {
    var opener = e.target.closest('a[href$="#sign-in"], a[href$="#sign-up"]');
    if (opener && !wrap.contains(opener)) { e.preventDefault(); set(true, /#sign-up$/.test(opener.getAttribute('href')) ? 'up' : 'in'); return; }
    if (!panel.hidden && !wrap.contains(e.target)) set(false);
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) { set(false); btn.focus(); } });

  var welcome = /[?&]welcome=1(&|$)/.test(location.search);
  if (welcome && window.history && history.replaceState) {
    var q = location.search.replace(/([?&])welcome=1(&|$)/, function (m, a, b) { return b ? a : ''; }).replace(/[?&]$/, '');
    history.replaceState(null, '', location.pathname + q + location.hash);
  }
  var t = document.getElementById('acct-toast');
  if (!t) return;
  if (welcome && t.getAttribute('data-new')) {
    t.querySelector('.acct-toast__t').textContent = t.getAttribute('data-new');
  } else {
    try {
      var k = 'gz-hi-' + t.getAttribute('data-id');
      if (sessionStorage.getItem(k)) return;
      sessionStorage.setItem(k, '1');
    } catch (err) { return; }
  }
  document.body.appendChild(t); // raus aus dem Header (backdrop-filter würde position:fixed einsperren)
  t.hidden = false;
  requestAnimationFrame(function () { requestAnimationFrame(function () { t.classList.add('on'); }); });
  setTimeout(function () { t.classList.remove('on'); setTimeout(function () { t.hidden = true; }, 400); }, 4600);
})();
</script>
