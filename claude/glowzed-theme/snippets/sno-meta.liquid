{%- comment -%}
  Vorschau beim Teilen von Links (WhatsApp, iMessage, Instagram, Facebook, X).
  Produktseiten zeigen das Produktbild, alle anderen Seiten das Bild „glowzed-share.jpg“ aus Inhalte → Dateien.
{%- endcomment -%}
{%- liquid
  assign meta_default = 'sno.meta_description' | t
  assign og_title = seo_title | default: page_title | default: shop.name
  assign og_desc = seo_desc | default: page_description | default: shop.description | default: meta_default
  assign og_type = 'website'
  assign og_image = ''
  if request.page_type == 'product' and product.featured_image
    assign og_type = 'product'
    assign og_image = product.featured_image | image_url: width: 1200
  else
    assign share = images['glowzed-share.jpg']
    if share != blank
      assign og_image = share | image_url: width: 1200
    else
      assign og_image = '//cdn.shopify.com/s/files/1/1117/8380/5319/files/glowzed-share.jpg'
    endif
  endif
  if og_image contains '//'
    unless og_image contains 'https:'
      assign og_image = 'https:' | append: og_image
    endunless
  endif
-%}
<meta property="og:site_name" content="{{ settings.brand | default: shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape_once }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_desc | strip_html | escape_once }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:secure_url" content="{{ og_image }}">
{%- if og_type == 'website' -%}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- endif -%}
{%- if og_type == 'product' -%}
<meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | escape }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape_once }}">
<meta name="twitter:description" content="{{ og_desc | strip_html | escape_once }}">
<meta name="twitter:image" content="{{ og_image }}">
